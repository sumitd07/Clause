{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules.schema.json",
  "title": "Rule set for one policy",
  "type": "object",
  "required": [
    "policy_id",
    "rules"
  ],
  "properties": {
    "policy_id": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "calculation_order": {
      "type": "array",
      "items": {
        "enum": [
          "non_payable",
          "room_rent",
          "sub_limit",
          "copay",
          "sum_insured_cap"
        ]
      },
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "doc",
        "section",
        "quote"
      ],
      "additionalProperties": false,
      "properties": {
        "doc": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "quote": {
          "type": "string",
          "minLength": 10
        },
        "page": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "type",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "overrides",
            "narrows",
            "activates"
          ]
        },
        "target": {
          "type": "string"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "status",
        "citation",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$"
        },
        "type": {
          "enum": [
            "waiting_period",
            "exclusion",
            "requires_review",
            "non_payable_items",
            "room_rent_limit",
            "sub_limit",
            "copay",
            "waiver"
          ]
        },
        "title": {
          "type": "string"
        },
        "plain": {
          "type": "string",
          "minLength": 10,
          "description": "What the rule means, in everyday words. Shown to the user under the quote. Checked by a person with the rest of the rule."
        },
        "status": {
          "enum": [
            "candidate",
            "approved",
            "rejected"
          ]
        },
        "requires_rider": {
          "type": [
            "string",
            "null"
          ]
        },
        "citation": {
          "$ref": "#/$defs/citation"
        },
        "params": {
          "type": "object"
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "review": {
          "type": "object",
          "description": "Who approved it and what they changed. Written by the review queue.",
          "properties": {
            "reviewer": {
              "type": "string"
            },
            "reviewed_on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "edited_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "comment": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "waiting_period"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": [
                  "scope",
                  "days"
                ],
                "properties": {
                  "scope": {
                    "enum": [
                      "all",
                      "listed_conditions",
                      "pre_existing"
                    ]
                  },
                  "days": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "waived_for_accident": {
                    "type": "boolean"
                  },
                  "conditions": {
                    "$ref": "#/$defs/tags"
                  },
                  "procedures": {
                    "$ref": "#/$defs/tags"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "exclusion",
                  "requires_review"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {
                  "conditions": {
                    "$ref": "#/$defs/tags"
                  },
                  "procedures": {
                    "$ref": "#/$defs/tags"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "non_payable_items"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": [
                  "categories"
                ],
                "properties": {
                  "categories": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "room",
                        "icu",
                        "doctor_fees",
                        "nursing",
                        "ot_charges",
                        "pharmacy",
                        "consumables",
                        "implants",
                        "diagnostics",
                        "non_medical",
                        "other"
                      ]
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "room_rent_limit"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": [
                  "limit_type",
                  "value"
                ],
                "properties": {
                  "limit_type": {
                    "enum": [
                      "percent_si",
                      "fixed"
                    ]
                  },
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "proportionate_deduction": {
                    "type": "boolean"
                  },
                  "associated_categories": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "room",
                        "icu",
                        "doctor_fees",
                        "nursing",
                        "ot_charges",
                        "pharmacy",
                        "consumables",
                        "implants",
                        "diagnostics",
                        "non_medical",
                        "other"
                      ]
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sub_limit"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": [
                  "cap_type",
                  "value"
                ],
                "properties": {
                  "cap_type": {
                    "enum": [
                      "fixed",
                      "percent_si"
                    ]
                  },
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "conditions": {
                    "$ref": "#/$defs/tags"
                  },
                  "procedures": {
                    "$ref": "#/$defs/tags"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "copay"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": [
                  "percent"
                ],
                "properties": {
                  "percent": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 100
                  },
                  "min_age": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "waiver"
              }
            }
          },
          "then": {
            "required": [
              "edges"
            ],
            "properties": {
              "edges": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
